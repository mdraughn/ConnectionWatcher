{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ConEngine": "Information"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "DbPath": "data/conwatch.db",
    "MinuteRetentionDays": 90,
    "HourlyRetentionMonths": 13,
    "RetentionRunHourUtc": 3,
    "RebuildDebounceSeconds": 2
  },
  "Verdict": {
    "AnchorPool": "Internet",
    "WeatherThreshold": 2
  }
}

@page
@model ConWatch.Pages.HistoryModel
@{
    ViewData["Title"] = "History — ConnectionWatcher";
}

<div class="cw-pageband">
    <div class="titles">
        <h2>History</h2>
        <p>Every state change, chart, and incident on record — times in your browser's zone.</p>
    </div>
    <a href="/Report" role="button" class="outline" style="white-space:nowrap">ISP report</a>
</div>
<script id="history-data" type="application/json">@Html.Raw(Model.SubjectsJson)</script>
<script id="history-topology" type="application/json">@Html.Raw(Model.TopologyJson)</script>
<div id="history-root">
    <p aria-busy="true">island pending</p>
</div>

@section Scripts {
    <script type="module" src="~/js/history.js" asp-append-version="true"></script>
}

@page
@using ConPersistence
@model ConWatch.Pages.DataModel
@{
    ViewData["Title"] = "Data — ConnectionWatcher";
}

<div class="cw-pageband">
    <div class="titles">
        <h2>Data</h2>
        <p>What's stored, how long it's kept, and how to get it out.</p>
    </div>
</div>

<h3>Database</h3>
<div class="cw-stats-row" id="db-stats" aria-busy="true">loading…</div>

<h3>Exports</h3>
<p>
    <a href="/api/v1/export/transitions?format=csv" role="button" class="outline">Transitions CSV</a>
    <a href="/api/v1/export/transitions?format=json" role="button" class="outline">Transitions JSON</a>
    <a href="/api/v1/export/rollups?format=csv" role="button" class="outline">Rollups CSV</a>
    <a href="/api/v1/export/rollups?format=json" role="button" class="outline">Rollups JSON</a>
    <a href="/api/v1/export/glitches?format=csv" role="button" class="outline">Glitches CSV</a>
    <a href="/api/v1/export/glitches?format=json" role="button" class="outline">Glitches JSON</a>
    <a href="/api/v1/export/snapshot" role="button" class="outline">Snapshot JSON</a>
    &nbsp;·&nbsp; <a href="/Report">ISP report</a>
</p>
<p><small>The snapshot is the complete sanitized state — configuration, settings
(secrets redacted), and all measurement data — the document backups and the
clone wizard use.</small></p>

<h3>Retention</h3>
<p><small>Data downsamples instead of growing forever: per-minute statistics
are kept for the window below, then survive as hourly rollups, then daily
rollups (kept indefinitely). Glitches are pruned with the minute window.
State transitions — the incident history — are kept for the months below;
each subject's most recent transition always survives (warm restart resumes
from it). The pass runs nightly.</small></p>
<ul class="form-errors" id="retention-errors"></ul>
<form id="retention-form">
    <div class="grid">
        <label>Minute rollups kept (days)
            <input name="@SettingKeys.MinuteRetentionDays" type="number" min="1" max="3650"
                   value="@Model.Setting(SettingKeys.MinuteRetentionDays, "90")" />
        </label>
        <label>Hourly rollups kept (months)
            <input name="@SettingKeys.HourlyRetentionMonths" type="number" min="1" max="120"
                   value="@Model.Setting(SettingKeys.HourlyRetentionMonths, "13")" />
        </label>
        <label>Transitions kept (months)
            <input name="@SettingKeys.TransitionRetentionMonths" type="number" min="1" max="120"
                   value="@Model.Setting(SettingKeys.TransitionRetentionMonths, "24")" />
        </label>
        <label>Retention run hour (UTC)
            <input name="@SettingKeys.RetentionRunHourUtc" type="number" min="0" max="23"
                   value="@Model.Setting(SettingKeys.RetentionRunHourUtc, "3")" />
        </label>
    </div>
    <button type="submit">Save retention settings</button>
</form>

@section Scripts {
    <script src="~/lib/site-config.js" asp-append-version="true"></script>
    <script src="~/lib/site-data.js" asp-append-version="true"></script>
}

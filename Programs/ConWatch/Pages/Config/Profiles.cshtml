@page
@using System.Text.Json
@using ConCore.Targets
@model ConWatch.Pages.Config.ProfilesModel
@{
    ViewData["Title"] = "Profiles — ConnectionWatcher";
    var json = (object o) => JsonSerializer.Serialize(o, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div class="cw-pageband">
    <div class="titles">
        <h2>Profiles</h2>
        <p>Ping discipline bundles: cadence, bursts, and the state thresholds.</p>
    </div>
</div>
<partial name="_ConfigTabs" model="@("profiles")" />
<partial name="_HealthBanner" model="Model.Warnings" />
<p>Ping discipline bundles. Intervals and durations are in seconds; thresholds are 0–1 success rates.</p>

<table>
    <thead><tr><th>Name</th><th>Description</th><th>Normal</th><th>Burst</th><th>Burst cap</th><th>Timeout</th><th>Window</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model.Config.Profiles.OrderBy(p => p.Name))
    {
        <tr>
            <td>@p.Name</td>
            <td class="cw-muted">@p.Description</td>
            <td>@(p.NormalIntervalSeconds)s</td>
            <td>@(p.BurstIntervalSeconds)s</td>
            <td>@(p.BurstMaxDurationSeconds)s</td>
            <td>@(p.PingTimeoutSeconds)s</td>
            <td>@p.MinUsableSample/@p.HistorySize</td>
            <td>
                <button class="outline" data-edit="@p.Id" data-json="@json(p)">Edit</button>
                @* Built-ins come back at the next start (EnsureBuiltInsAsync), so deleting one is a no-op with extra steps. *@
                @if (!PingProfile.IsBuiltIn(p.Name))
                {
                    <button class="outline" data-delete="@p.Id" data-name="@p.Name">Delete</button>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

<p class="cw-actions">
    <button data-add>Add profile</button>
</p>
<ul class="form-errors" id="errors"></ul>

<dialog id="profile-dialog">
    <article>
        <header><h4 data-dialog-title>Add profile</h4></header>
        <ul class="form-errors" id="dialog-errors"></ul>
        <form id="profile-form">
            <label>Name <input name="name" required /></label>
            <label>Description <small>(optional — what this profile is for)</small>
                <textarea name="description" rows="2" maxlength="500"></textarea>
            </label>
            <div class="grid">
                <label>Normal interval (s) <input name="normalIntervalSeconds" type="number" step="any" value="@ProfilesModel.DialogDefaults["normalIntervalSeconds"]" /></label>
                <label>Burst interval (s) <input name="burstIntervalSeconds" type="number" step="any" value="@ProfilesModel.DialogDefaults["burstIntervalSeconds"]" /></label>
                <label>Burst max duration (s) <input name="burstMaxDurationSeconds" type="number" step="any" value="@ProfilesModel.DialogDefaults["burstMaxDurationSeconds"]" /></label>
                <label>Ping timeout (s) <input name="pingTimeoutSeconds" type="number" step="any" value="@ProfilesModel.DialogDefaults["pingTimeoutSeconds"]" /></label>
            </div>
            <div class="grid">
                <label>History size <input name="historySize" type="number" value="@ProfilesModel.DialogDefaults["historySize"]" /></label>
                <label>Min usable sample <input name="minUsableSample" type="number" value="@ProfilesModel.DialogDefaults["minUsableSample"]" /></label>
            </div>
            <div class="grid">
                <label>Responding ≥ <input name="respondingThreshold" type="number" step="any" value="@ProfilesModel.DialogDefaults["respondingThreshold"]" /></label>
                <label>Faltering &lt; <input name="falteringThreshold" type="number" step="any" value="@ProfilesModel.DialogDefaults["falteringThreshold"]" /></label>
                <label>Down &lt; <input name="downThreshold" type="number" step="any" value="@ProfilesModel.DialogDefaults["downThreshold"]" /></label>
                <label>Recovering ≥ <input name="recoveringThreshold" type="number" step="any" value="@ProfilesModel.DialogDefaults["recoveringThreshold"]" /></label>
            </div>
            <footer>
                <button type="button" class="secondary outline" data-cancel>Cancel</button>
                <button type="submit">Add profile</button>
            </footer>
        </form>
    </article>
</dialog>

@section Scripts {
    <script src="~/lib/site-config.js" asp-append-version="true"></script>
    <script>
        const form = document.getElementById("profile-form");
        const dialog = document.getElementById("profile-dialog");
        const numberFields = ["normalIntervalSeconds", "burstIntervalSeconds", "burstMaxDurationSeconds",
            "pingTimeoutSeconds", "historySize", "minUsableSample", "respondingThreshold",
            "falteringThreshold", "downThreshold", "recoveringThreshold"];
        wireConfigPage({
            form,
            dialog,
            errorList: document.getElementById("dialog-errors"),
            pageErrorList: document.getElementById("errors"),
            noun: "profile",
            endpoint: "/api/v1/profiles",
            buildDto: () => {
                const dto = { name: form.elements.name.value, description: form.elements.description.value || null };
                for (const f of numberFields) dto[f] = Number(form.elements[f].value);
                return dto;
            },
            fillForm: (dto) => {
                form.elements.name.value = dto.name;
                form.elements.description.value = dto.description ?? "";
                for (const f of numberFields) form.elements[f].value = dto[f];
            },
        });
    </script>
}

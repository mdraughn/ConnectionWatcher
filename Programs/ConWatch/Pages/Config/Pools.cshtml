@page
@using System.Text.Json
@using ConPersistence.Settings
@model ConWatch.Pages.Config.PoolsModel
@{
    ViewData["Title"] = "Pools — ConnectionWatcher";
    var json = (object o) => JsonSerializer.Serialize(o, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div class="cw-pageband">
    <div class="titles">
        <h2>Pools</h2>
        <p>Rotation groups that share the pinging load and anchor the verdict.</p>
    </div>
</div>
<partial name="_ConfigTabs" model="@("pools")" />
<partial name="_HealthBanner" model="Model.Warnings" />
<p>Rotation pools: members share the pinging load by phase-stagger; pool state is derived (any member responding → responding). Member order sets the stagger offsets.</p>

<h3>Verdict</h3>
<p>The verdict reads the members of one pool, the internet anchors. Other pools only
   share pinging load and report a combined state.</p>
<ul class="form-errors" id="verdict-errors"></ul>
<form id="verdict-form">
    <div class="grid">
        <label>Anchor pool
            <select name="@SettingKeys.AnchorPool">
                <option value="">(none — verdict off)</option>
                @foreach (var pool in Model.Config.Pools.OrderBy(p => p.Name))
                {
                    <option selected="@Model.IsAnchor(pool)">@pool.Name</option>
                }
            </select>
        </label>
        <label>Anchors needed for Healthy
            <input name="@SettingKeys.WeatherThreshold" type="number" min="1" value="@Model.WeatherThreshold" />
        </label>
        <div style="align-self: end"><button type="submit">Save verdict settings</button></div>
    </div>
</form>

<h3>Pools</h3>
<table>
    <thead><tr><th>Name</th><th>Members (in order)</th><th>Parent</th><th></th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model.Config.Pools.OrderBy(p => p.Name))
    {
        <tr>
            <td>@p.Name</td>
            <td>@string.Join(" → ", p.Members)</td>
            <td>@(p.Parent ?? "—")</td>
            <td>@if (Model.IsAnchor(p)) { <span class="cw-chip">anchor</span> }</td>
            <td>
                <button class="outline" data-edit="@p.Id" data-json="@json(p)">Edit</button>
                <button class="outline" data-delete="@p.Id" data-name="@p.Name">Delete</button>
            </td>
        </tr>
    }
    </tbody>
</table>

<p class="cw-actions">
    <button data-add>Add pool</button>
</p>
<ul class="form-errors" id="errors"></ul>

<dialog id="pool-dialog">
    <article>
        <header><h4 data-dialog-title>Add pool</h4></header>
        <ul class="form-errors" id="dialog-errors"></ul>
        <form id="pool-form">
            <div class="grid">
                <label>Name <input name="name" required /></label>
                <label>Parent
                    <select name="parent">
                        <option value="">(none)</option>
                        @foreach (var t in Model.Config.Targets.OrderBy(t => t.Name))
                        {
                            <option>@t.Name</option>
                        }
                    </select>
                </label>
            </div>
            <fieldset>
                <legend>Members (click to add, in stagger order)</legend>
                <div class="grid">
                    <div>
                        @foreach (var t in Model.Config.Targets.OrderBy(t => t.Name))
                        {
                            <button type="button" class="outline" data-add-member="@t.Name">@t.Name</button>
                        }
                    </div>
                    <div>
                        <ol id="member-list"></ol>
                    </div>
                </div>
            </fieldset>
            <footer>
                <button type="button" class="secondary outline" data-cancel>Cancel</button>
                <button type="submit">Add pool</button>
            </footer>
        </form>
    </article>
</dialog>

@section Scripts {
    <script src="~/lib/site-config.js" asp-append-version="true"></script>
    <script>
        const form = document.getElementById("pool-form");
        const dialog = document.getElementById("pool-dialog");
        const memberList = document.getElementById("member-list");
        let members = [];

        function renderMembers() {
            memberList.innerHTML = "";
            members.forEach((name, i) => {
                const li = document.createElement("li");
                li.textContent = name + " ";
                const up = document.createElement("button");
                up.type = "button"; up.className = "outline"; up.textContent = "↑";
                up.onclick = () => { if (i > 0) { [members[i-1], members[i]] = [members[i], members[i-1]]; renderMembers(); } };
                const remove = document.createElement("button");
                remove.type = "button"; remove.className = "outline"; remove.textContent = "✕";
                remove.onclick = () => { members.splice(i, 1); renderMembers(); };
                li.append(up, remove);
                memberList.appendChild(li);
            });
        }

        document.querySelectorAll("[data-add-member]").forEach((btn) =>
            btn.addEventListener("click", () => {
                const name = btn.dataset.addMember;
                if (!members.includes(name)) { members.push(name); renderMembers(); }
            }));

        wireConfigPage({
            form,
            dialog,
            errorList: document.getElementById("dialog-errors"),
            pageErrorList: document.getElementById("errors"),
            noun: "pool",
            endpoint: "/api/v1/pools",
            buildDto: () => ({
                name: form.elements.name.value,
                parent: form.elements.parent.value || null,
                members,
            }),
            fillForm: (dto) => {
                form.elements.name.value = dto.name;
                form.elements.parent.value = dto.parent ?? "";
                members = [...dto.members];
                renderMembers();
            },
            resetForm: () => { members = []; renderMembers(); },
        });
        wireSettingsForm("verdict-form", "verdict-errors");
    </script>
}

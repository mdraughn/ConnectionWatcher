@page
@using System.Text.Json
@using ConCore.Targets
@model ConWatch.Pages.Config.TargetsModel
@{
    ViewData["Title"] = "Targets — ConnectionWatcher";
    var json = (object? o) => JsonSerializer.Serialize(o, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div class="cw-pageband">
    <div class="titles">
        <h2>Targets</h2>
        <p>What gets probed: the path to the internet and the sites watched beyond it.</p>
    </div>
</div>
<partial name="_ConfigTabs" model="@("targets")" />
<partial name="_HealthBanner" model="Model.Warnings" />
<p>
    Changes apply within seconds — the engine rebuilds automatically.
    <a href="/Setup">Run quick setup</a> to add the standard router + anchors.
</p>

@if (Model.TrunkChains.Count > 0 || Model.DirectAnchors.Count > 0)
{
    <h3>Path to the internet</h3>
    @foreach (var chain in Model.TrunkChains)
    {
        <div class="cw-pipeline">
            @for (var i = 0; i < chain.Count; i++)
            {
                var stage = chain[i];
                <div class="cw-stage">
                    <b>@stage.Name</b> <small>@stage.Address</small>
                    @if (Model.BranchesByTrunkName.TryGetValue(stage.Name, out var branches))
                    {
                        <small class="cw-branches">⌐ @string.Join(", ", branches.Select(b => b.Name))</small>
                    }
                </div>
                var below = i + 1 < chain.Count
                    ? new[] { chain[i + 1].Id!.Value }
                    : Model.AnchorsUnder(stage.Name).Select(a => a.Id!.Value).ToArray();
                @if (below.Length > 0)
                {
                    <div class="cw-insert">
                        <button class="outline" data-insert-children='@System.Text.Json.JsonSerializer.Serialize(below)'
                                data-insert-label="between @stage.Name and what follows">⊕ insert here</button>
                    </div>
                }
            }
            <div class="cw-stage cw-anchors">
                <b>Internet anchors</b>
                <small>@string.Join(", ", Model.AnchorsUnder(chain[^1].Name).Select(a => a.Name))</small>
            </div>
        </div>
    }
    @if (Model.DirectAnchors.Count > 0)
    {
        <div class="cw-pipeline">
            <div class="cw-stage cw-anchors">
                <b>Internet anchors</b>
                <small>reached directly (no parent) · @string.Join(", ", Model.DirectAnchors.Select(a => a.Name))</small>
            </div>
        </div>
    }
}

<table>
    <thead><tr><th>Name</th><th>Address</th><th>Parent</th><th>Profile</th><th>Scope</th><th>Enabled</th><th></th></tr></thead>
    <tbody>
    @foreach (var t in Model.Config.Targets.OrderBy(t => t.Name))
    {
        <tr>
            <td>@t.Name</td><td>@t.Address@(t.Probe is { Length: > 0 } pr ? $" · {pr.Replace(":", "/")}" : "")</td><td>@(t.Parent ?? "—")</td><td>@t.Profile</td><td>@(t.Scope == TargetScope.Local ? "Local" : "Verdict")</td>
            <td>@(t.Enabled ? "yes" : "no")</td>
            <td>
                <button class="outline" data-edit="@t.Id" data-json="@json(t)">Edit</button>
                <button class="outline" data-delete="@t.Id" data-name="@t.Name">Delete</button>
            </td>
        </tr>
    }
    </tbody>
</table>

<p class="cw-actions">
    <button data-add>Add target</button>
</p>
<ul class="form-errors" id="errors"></ul>

<dialog id="target-dialog">
    <article>
        <header><h4 data-dialog-title>Add target</h4></header>
        <ul class="form-errors" id="dialog-errors"></ul>
        <form id="target-form">
            <div class="grid">
                <label>Name <input name="name" required value="@Model.PrefillName" /></label>
                <label>Address
                    <fieldset role="group" style="margin:0">
                        <input name="address" required placeholder="IP or hostname" value="@Model.PrefillAddress" />
                        <button type="button" class="outline" id="probe-test-btn">Test</button>
                    </fieldset>
                    <small id="probe-test-out"></small>
                </label>
            </div>
            <div class="grid">
                <label>Parent
                    <select name="parent">
                        <option value="">(none — root)</option>
                        @foreach (var t in Model.Config.Targets.Where(t => t.Scope != TargetScope.Local).OrderBy(t => t.Name))
                        {
                            <option selected="@(t.Name == Model.PrefillParent)">@t.Name</option>
                        }
                    </select>
                </label>
                <label>Profile
                    <select name="profile">
                        @foreach (var p in Model.Config.Profiles.OrderBy(p => p.Name))
                        {
                            <option selected="@p.Name.Equals(Model.DefaultProfile, StringComparison.OrdinalIgnoreCase)" title="@p.Description">@p.Name</option>
                        }
                    </select>
                </label>
                <label>Enabled <input type="checkbox" name="enabled" checked /></label>
            </div>
            <label>Scope
                <select name="scope" id="scope-select">
                    <option value="Verdict" selected="@(!string.Equals(Model.PrefillScope, "Local", StringComparison.OrdinalIgnoreCase))">Internet path — counts toward the verdict</option>
                    <option value="Local" selected="@string.Equals(Model.PrefillScope, "Local", StringComparison.OrdinalIgnoreCase)">LAN device — tracked on the side, never affects the verdict</option>
                </select>
            </label>
            <div class="grid">
                <label>Probe
                    <select name="probeKind" id="probe-kind">
                        <option value="">Ping (ICMP)</option>
                        <option value="tcp">TCP connect</option>
                    </select>
                </label>
                <label id="probe-port-label" hidden>Port
                    <input name="probePort" type="number" min="1" max="65535" value="80" />
                </label>
            </div>
            <label>ISP / operator <small>(optional — lets reports say "Comcast is down")</small>
                <input name="operator" placeholder="e.g. Comcast" value="@Model.PrefillOperator" />
            </label>
            <footer>
                <button type="button" class="secondary outline" data-cancel>Cancel</button>
                <button type="submit">Add target</button>
            </footer>
        </form>
    </article>
</dialog>

<dialog id="addr-dialog">
    <article>
        <h4>Address changed</h4>
        <p>
            What does this change mean? It decides whether the target's history
            continues or starts fresh.
        </p>
        <p>
            <button class="outline" data-kind="correction">I'm correcting a mistake<br />
                <small>the old address was wrong — start a fresh history</small></button>
            <button class="outline" data-kind="repoint">This is a different device/interface<br />
                <small>measuring something new — start a fresh history</small></button>
            <button class="outline" data-kind="renumber">Same device, new address<br />
                <small>e.g. the ISP renumbered it — continue the history</small></button>
        </p>
        <p><button class="secondary" data-kind="">Cancel</button></p>
    </article>
</dialog>

<h3>Backup</h3>
<p>
    <a href="/api/v1/config/export" download="conwatch-config.json" role="button" class="outline">Export config</a>
    <label style="display:inline-block">Import: <input type="file" id="import-file" accept=".json" /></label>
</p>

@section Scripts {
    <script src="~/lib/site-config.js" asp-append-version="true"></script>
    <script>
        const form = document.getElementById("target-form");
        const dialog = document.getElementById("target-dialog");

        const scopeSelect = document.getElementById("scope-select");
        const parentSelect = form.elements.parent;
        const pageDefaultProfile = @Html.Raw(json(Model.DefaultProfile));
        const adoptDiscoveryId = @Html.Raw(json(Model.PrefillDiscoveryId));
        let adoptingId = adoptDiscoveryId;
        const prefilled = new URLSearchParams(location.search).has("address");
        function applyScope() {
            const local = scopeSelect.value === "Local";
            parentSelect.disabled = local;   // a LAN device is always a root
            if (local) parentSelect.value = "";
        }
        scopeSelect.addEventListener("change", () => {
            applyScope();
            const profile = form.elements.profile;
            const hasLocalProfile = [...profile.options].some((o) => o.value === "Local");
            // Follow the scope with the profile unless the user already picked another one.
            if (scopeSelect.value === "Local" && hasLocalProfile && profile.value === pageDefaultProfile)
                profile.value = "Local";
            else if (scopeSelect.value === "Verdict" && profile.value === "Local")
                profile.value = pageDefaultProfile === "Local" ? "Public" : pageDefaultProfile;
        });
        applyScope();

        const probeKind = document.getElementById("probe-kind");
        const portLabel = document.getElementById("probe-port-label");
        probeKind.addEventListener("change", () => { portLabel.hidden = probeKind.value !== "tcp"; });

        function setProbe(probe) {           // probe: null | "tcp:80"
            const m = /^tcp:(\d+)$/.exec(probe ?? "");
            probeKind.value = m ? "tcp" : "";
            if (m) form.elements.probePort.value = m[1];
            portLabel.hidden = !m;
        }

        document.getElementById("probe-test-btn").addEventListener("click", async () => {
            const out = document.getElementById("probe-test-out");
            out.textContent = "testing…";
            const body = { address: form.elements.address.value };
            if (probeKind.value === "tcp") body.port = Number(form.elements.probePort.value);
            const r = await apiFetch("POST", "/api/v1/targets/probe-test", body);
            if (!r.ok) { out.textContent = "test failed"; return; }
            const results = r.body.results;
            const ips = r.body.resolvedIps ?? [];
            out.textContent = results.length === 0 ? "address did not resolve"
                : results.map((x) => `${x.probe.replace(":", "/")}: ${x.reply ? `reply ${x.rttMs} ms` : "no reply"}`).join(" · ");
            // A hostname with several addresses: show what is being pinned.
            // One address is monitored at a time; the engine follows changes.
            if (ips.length > 1)
                out.textContent += ` — resolves to ${ips.length} addresses (${ips.join(", ")}); monitoring ${r.body.resolvedIp}, follows DNS changes`;
            else if (ips.length === 1 && ips[0] !== form.elements.address.value.trim())
                out.textContent += ` — resolves to ${ips[0]}`;
            const icmp = results.find((x) => x.probe === "icmp" && x.reply);
            const tcpCandidates = results.filter((x) => x.probe !== "icmp" && x.reply);
            // Prefer an accepted port: a refused port replies in ~0ms and can
            // out-rank an accepted one on RTT alone (production runs Linux,
            // where refusals reply instantly) — exactly the port the
            // persistent-refusal warning would then flag. Fall back to any
            // replying TCP candidate only if none were accepted.
            const bestTcp = tcpCandidates.filter((x) => x.message === "Accepted")
                .sort((a, b) => a.rttMs - b.rttMs)[0]
                ?? tcpCandidates.sort((a, b) => a.rttMs - b.rttMs)[0];
            setProbe(icmp ? null : bestTcp ? bestTcp.probe : null);
        });

        function askAddressChange() {
            const dialog = document.getElementById("addr-dialog");
            return new Promise((resolve) => {
                const onClick = (e) => {
                    const kind = e.target.closest("[data-kind]")?.dataset.kind;
                    if (kind === undefined) return;
                    dialog.removeEventListener("click", onClick);
                    dialog.close();
                    resolve(kind || null);
                };
                dialog.addEventListener("click", onClick);
                dialog.showModal();
            });
        }

        const { open } = wireConfigPage({
            form,
            dialog,
            errorList: document.getElementById("dialog-errors"),
            pageErrorList: document.getElementById("errors"),
            noun: "target",
            endpoint: "/api/v1/targets",
            beforeSave: async ({ isEdit, dto }) => {
                // Insert mode: create the target AND re-parent the chosen
                // children in one atomic operation, then stop the normal flow.
                if (!isEdit && form.dataset.insertChildIds) {
                    const errors = document.getElementById("dialog-errors");
                    clearErrors(errors);
                    const result = await apiFetch("POST", "/api/v1/targets/insert-parent", {
                        newTarget: dto,
                        childIds: JSON.parse(form.dataset.insertChildIds),
                    });
                    if (result.ok) location.reload();
                    else showErrors(errors, result);
                    return false;
                }
                if (!isEdit && adoptingId) {
                    // Strip the prefill from the URL first so the reload after a successful
                    // adoption does not re-open the dialog; a failed save keeps adoptingId for the retry.
                    history.replaceState(null, "", location.pathname);
                    return { query: `?discoveryId=${encodeURIComponent(adoptingId)}` };
                }
                const original = form.dataset.originalAddress;
                if (!isEdit || !original ||
                    dto.address.trim().toLowerCase() === original.toLowerCase())
                    return {};
                const kind = await askAddressChange();
                if (!kind) return false; // cancelled
                return { query: `?addressChange=${kind}` };
            },
            buildDto: () => ({
                name: form.elements.name.value,
                address: form.elements.address.value,
                scope: scopeSelect.value,
                parent: scopeSelect.value === "Local" ? null : (form.elements.parent.value || null),
                profile: form.elements.profile.value,
                enabled: form.elements.enabled.checked,
                operator: form.elements.operator.value || null,
                probe: probeKind.value === "tcp" ? `tcp:${form.elements.probePort.value}` : null,
            }),
            fillForm: (dto) => {
                form.dataset.originalAddress = dto.address;
                form.elements.name.value = dto.name;
                form.elements.address.value = dto.address;
                form.elements.parent.value = dto.parent ?? "";
                form.elements.profile.value = dto.profile;
                form.elements.enabled.checked = dto.enabled;
                form.elements.operator.value = dto.operator ?? "";
                scopeSelect.value = dto.scope ?? "Verdict"; applyScope();
                setProbe(dto.probe ?? null);
            },
            resetForm: () => {
                adoptingId = null;
                applyScope();
                // A prefilled page has the prefill baked into its defaults: re-render without it.
                if (prefilled) location.replace(location.pathname);
                setProbe(null);
                document.getElementById("probe-test-out").textContent = "";
            },
        });
        document.querySelectorAll("[data-insert-children]").forEach((btn) =>
            btn.addEventListener("click", () => {
                form.dataset.insertChildIds = btn.dataset.insertChildren;
                open({ title: `Insert new target ${btn.dataset.insertLabel}`,
                       submitLabel: "Insert into path" });
            }));
        // The traceroute page links here with the address pre-filled: open
        // the form right away rather than making the user find "Add target".
        // One-shot: clean the URL now so no later reload re-opens the dialog or re-arms the adoption.
        if (prefilled) { open({ title: "Add target", submitLabel: "Add target" }); history.replaceState(null, "", location.pathname); }

        document.getElementById("import-file").addEventListener("change", async (e) => {
            const file = e.target.files[0];
            if (!file) return;
            if (!await confirmDialog("Replace the ENTIRE configuration with this file?",
                                     { confirmLabel: "Replace configuration" })) {
                e.target.value = "";
                return;
            }
            const doc = JSON.parse(await file.text());
            const result = await apiFetch("POST", "/api/v1/config/import", doc);
            if (result.ok) location.reload();
            else showErrors(document.getElementById("errors"), result);
        });
    </script>
}

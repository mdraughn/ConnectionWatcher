@page
@using System.Text.Json
@model ConWatch.Pages.Config.TargetsModel
@{
    ViewData["Title"] = "Targets — ConnectionWatcher";
    var json = (object o) => JsonSerializer.Serialize(o, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<h2>Targets</h2>
<partial name="_HealthBanner" model="Model.Warnings" />
<p>Changes apply within seconds — the engine rebuilds automatically.</p>

<table>
    <thead><tr><th>Name</th><th>Address</th><th>Parent</th><th>Profile</th><th>Enabled</th><th></th></tr></thead>
    <tbody>
    @foreach (var t in Model.Config.Targets.OrderBy(t => t.Name))
    {
        <tr>
            <td>@t.Name</td><td>@t.Address</td><td>@(t.Parent ?? "—")</td><td>@t.Profile</td>
            <td>@(t.Enabled ? "yes" : "no")</td>
            <td>
                <button class="outline" data-edit="@t.Id" data-json="@json(t)">Edit</button>
                <button class="outline" data-delete="@t.Id" data-name="@t.Name">Delete</button>
            </td>
        </tr>
    }
    </tbody>
</table>

<h3 id="form-title">Add target</h3>
<ul class="form-errors" id="errors"></ul>
<form id="target-form">
    <div class="grid">
        <label>Name <input name="name" required value="@Model.PrefillName" /></label>
        <label>Address <input name="address" required placeholder="IP or hostname" value="@Model.PrefillAddress" /></label>
    </div>
    <div class="grid">
        <label>Parent
            <select name="parent">
                <option value="">(none — root)</option>
                @foreach (var t in Model.Config.Targets.OrderBy(t => t.Name))
                {
                    <option selected="@(t.Name == Model.PrefillParent)">@t.Name</option>
                }
            </select>
        </label>
        <label>Profile
            <select name="profile">
                @foreach (var p in Model.Config.Profiles.OrderBy(p => p.Name))
                {
                    <option selected="@(p.Name == "External")">@p.Name</option>
                }
            </select>
        </label>
        <label>Enabled <input type="checkbox" name="enabled" checked /></label>
    </div>
    <button type="submit">Add target</button>
</form>

<dialog id="addr-dialog">
    <article>
        <h4>Address changed</h4>
        <p>
            What does this change mean? It decides whether the target's history
            continues or starts fresh.
        </p>
        <p>
            <button class="outline" data-kind="correction">I'm correcting a mistake<br />
                <small>the old address was wrong — start a fresh history</small></button>
            <button class="outline" data-kind="repoint">This is a different device/interface<br />
                <small>measuring something new — start a fresh history</small></button>
            <button class="outline" data-kind="renumber">Same device, new address<br />
                <small>e.g. the ISP renumbered it — continue the history</small></button>
        </p>
        <p><button class="secondary" data-kind="">Cancel</button></p>
    </article>
</dialog>

<h3>Backup</h3>
<p>
    <a href="/api/v1/config/export" download="conwatch-config.json" role="button" class="outline">Export config</a>
    <label style="display:inline-block">Import: <input type="file" id="import-file" accept=".json" /></label>
</p>

@section Scripts {
    <script src="~/lib/site-config.js" asp-append-version="true"></script>
    <script>
        const form = document.getElementById("target-form");

        function askAddressChange() {
            const dialog = document.getElementById("addr-dialog");
            return new Promise((resolve) => {
                const onClick = (e) => {
                    const kind = e.target.closest("[data-kind]")?.dataset.kind;
                    if (kind === undefined) return;
                    dialog.removeEventListener("click", onClick);
                    dialog.close();
                    resolve(kind || null);
                };
                dialog.addEventListener("click", onClick);
                dialog.showModal();
            });
        }

        wireConfigPage({
            form,
            errorList: document.getElementById("errors"),
            endpoint: "/api/v1/targets",
            beforeSave: async ({ isEdit, dto }) => {
                const original = form.dataset.originalAddress;
                if (!isEdit || !original ||
                    dto.address.trim().toLowerCase() === original.toLowerCase())
                    return {};
                const kind = await askAddressChange();
                if (!kind) return false; // cancelled
                return { query: `?addressChange=${kind}` };
            },
            buildDto: () => ({
                name: form.elements.name.value,
                address: form.elements.address.value,
                parent: form.elements.parent.value || null,
                profile: form.elements.profile.value,
                enabled: form.elements.enabled.checked,
            }),
            fillForm: (dto) => {
                form.dataset.originalAddress = dto.address;
                form.elements.name.value = dto.name;
                form.elements.address.value = dto.address;
                form.elements.parent.value = dto.parent ?? "";
                form.elements.profile.value = dto.profile;
                form.elements.enabled.checked = dto.enabled;
                document.getElementById("form-title").textContent = `Edit ${dto.name}`;
            },
        });
        document.getElementById("import-file").addEventListener("change", async (e) => {
            const file = e.target.files[0];
            if (!file || !confirm("Replace the ENTIRE configuration with this file?")) return;
            const doc = JSON.parse(await file.text());
            const result = await apiFetch("POST", "/api/v1/config/import", doc);
            if (result.ok) location.reload();
            else showErrors(document.getElementById("errors"), result);
        });
    </script>
}

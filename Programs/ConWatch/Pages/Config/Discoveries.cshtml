@page
@using ConCore.Discovery
@model ConWatch.Pages.Config.DiscoveriesModel
@{
    ViewData["Title"] = "Discoveries — ConnectionWatcher";
}

<div class="cw-pageband">
    <div class="titles">
        <h2>Discoveries</h2>
        <p>Things found on the network that nobody is monitoring yet. Adopt one to turn it into a target, or hide it.</p>
    </div>
</div>
<partial name="_ConfigTabs" model="@("discoveries")" />

<p>
    <button type="button" id="find-router">Find my router</button>
    <button type="button" id="find-edge" class="outline">Find the network edge</button>
    <button type="button" id="find-lan" class="outline">Scan local network</button>
    <span id="search-status" aria-live="polite"></span>
</p>
<ul class="form-errors" id="errors"></ul>

<div class="cw-segmented" style="margin-bottom: 1rem">
    @foreach (var (key, label) in new[] { ("new", "New"), ("hidden", "Hidden"), ("adopted", "Adopted"), ("all", "All") })
    {
        <a class="@(Model.StatusFilter == key ? "active" : "")" href="/Config/Discoveries?status=@key">@label</a>
    }
</div>

@if (Model.StatusFilter == "hidden" && Model.Items.Count > 0)
{
    <p><button type="button" class="outline" id="restore-all">Unhide all</button></p>
}

@if (Model.StatusFilter is "new" or "all")
{
    <p>
        @if (Model.NewNetworkEdgeCount > 0)
        {
            <button type="button" class="outline" id="clear-NetworkEdge" data-clear-kind="NetworkEdge" data-count="@Model.NewNetworkEdgeCount" data-noun="network edge">Clear network edge</button>
        }
        @if (Model.NewLocalDeviceCount > 0)
        {
            <button type="button" class="outline" id="clear-LocalDevice" data-clear-kind="LocalDevice" data-count="@Model.NewLocalDeviceCount" data-noun="local device">Clear local devices</button>
        }
    </p>
}

@if (Model.Items.Count == 0)
{
    <p>Nothing here. Use the search buttons above.</p>
}
else
{
    <table>
        <thead><tr><th>Address</th><th>What</th><th>How found</th><th>Evidence</th><th>First seen</th><th>Last seen</th><th></th></tr></thead>
        <tbody>
        @foreach (var d in Model.Items)
        {
            <tr>
                <td>@d.Address@if (!string.IsNullOrEmpty(d.Hostname)) { <br /><small>@d.Hostname</small> }</td>
                <td>@ConWatch.Pages.Config.DiscoveriesModel.KindLabel(d.Kind)</td>
                <td>@ConWatch.Pages.Config.DiscoveriesModel.MethodLabel(d.Method)<br /><small>@d.Origin</small></td>
                <td><small>@d.Evidence</small></td>
                <td><small data-utc="@d.FirstSeenUtc.ToString("o")">@d.FirstSeenUtc.ToString("u")</small></td>
                <td><small data-utc="@d.LastSeenUtc.ToString("o")">@d.LastSeenUtc.ToString("u")</small></td>
                <td>
                    @if (d.Status == DiscoveryStatus.Adopted && d.AdoptedTargetName is { } adopted)
                    {
                        <span>→ <a href="/Config/Targets">@adopted</a></span>
                    }
                    else
                    {
                        @if (d.Status == DiscoveryStatus.Adopted)
                        {
                            <small>(target removed)</small>
                        }
                        @if (Model.MonitoredAs(d) is { } monitoredAs)
                        {
                            <small>already monitored as '@monitoredAs'</small>
                        }
                        else
                        {
                            <a role="button" class="outline" href="@Model.AdoptUrl(d)">Adopt</a>
                        }
                        @if (d.Status == DiscoveryStatus.Dismissed)
                        {
                            <button type="button" class="outline" data-action="restore" data-id="@d.Id">Unhide</button>
                        }
                        else
                        {
                            <button type="button" class="outline" data-action="dismiss" data-id="@d.Id">Hide</button>
                        }
                        @if (d.Status != DiscoveryStatus.Adopted)
                        {
                            <button type="button" class="outline" data-action="remove" data-id="@d.Id">Remove</button>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@section Scripts {
    <script src="~/lib/site-config.js" asp-append-version="true"></script>
    <script src="~/lib/site-time.js" asp-append-version="true"></script>
    <script>
        const errors = document.getElementById("errors");
        const statusLine = document.getElementById("search-status");

        localizeTimes("[data-utc]", "data-utc");

        async function search(button, url, label, nothingFound = "Nothing found.") {
            clearErrors(errors);
            button.setAttribute("aria-busy", "true");
            button.disabled = true;
            statusLine.textContent = `${label}…`;
            try {
                const result = await apiFetch("POST", url, {});
                if (!result.ok) {
                    statusLine.textContent = "";
                    showErrors(errors, result);
                    return;
                }
                const { found, created, partial, warning } = result.body;
                statusLine.textContent = found === 0
                    ? nothingFound + (warning ? " " + warning : "")
                    : `Found ${found} (${created} new).` +
                      (partial ? " Stopped at the time limit; this is what it found so far." : "") + (warning ? " " + warning : "");
                if (found > 0) setTimeout(() => location.reload(), (warning || partial) ? 4000 : 800);
            } catch (err) {
                statusLine.textContent = `The search could not be started: ${err?.message ?? err}`;
            } finally {
                button.disabled = false;
                button.removeAttribute("aria-busy");
            }
        }

        document.getElementById("find-router").addEventListener("click",
            (e) => search(e.currentTarget, "/api/v1/discoveries/search/router", "Looking for your router"));
        document.getElementById("find-edge").addEventListener("click",
            (e) => search(e.currentTarget, "/api/v1/discoveries/search/edge", "Tracing the way out of your network",
                "Nothing found: the hops past your router did not answer. Try again in a moment."));

        document.getElementById("find-lan").addEventListener("click",
            (e) => search(e.currentTarget, "/api/v1/discoveries/search/lan", "Scanning your local network",
                "Nothing found: no device answered on this network."));

        document.querySelectorAll("[data-action]").forEach((btn) =>
            btn.addEventListener("click", async () => {
                clearErrors(errors);
                const result = btn.dataset.action === "remove"
                    ? await apiFetch("DELETE", `/api/v1/discoveries/${btn.dataset.id}`)
                    : await apiFetch("POST", `/api/v1/discoveries/${btn.dataset.id}/${btn.dataset.action}`);
                if (result.ok) location.reload();
                else showErrors(errors, result);
            }));

        document.querySelectorAll("[data-clear-kind]").forEach((btn) =>
            btn.addEventListener("click", async () => {
                clearErrors(errors);
                const count = Number(btn.dataset.count);
                const noun = btn.dataset.noun + (count === 1 ? "" : "s");
                if (!await confirmDialog(`Remove ${count} new ${noun} from the list? Hidden and adopted ones are kept.`,
                        { confirmLabel: "Remove" })) return;
                const result = await apiFetch("POST", `/api/v1/discoveries/clear?kind=${btn.dataset.clearKind}`);
                if (result.ok) location.reload();
                else showErrors(errors, result);
            }));

        document.getElementById("restore-all")?.addEventListener("click", async () => {
            clearErrors(errors);
            const result = await apiFetch("POST", "/api/v1/discoveries/restore-dismissed");
            if (result.ok) location.href = "/Config/Discoveries";
            else showErrors(errors, result);
        });
    </script>
}

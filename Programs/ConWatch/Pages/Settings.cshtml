@page
@using ConPersistence
@using ConPersistence.Settings
@model ConWatch.Pages.SettingsModel
@{
    ViewData["Title"] = "Settings — ConnectionWatcher";
}

<div class="cw-pageband">
    <div class="titles">
        <h2>Settings</h2>
        <p>Node controls: monitoring, notifications, and the danger zone.
           Statistics, exports, and retention live on the <a href="/Data">Data</a> page;
           the verdict anchor is chosen on the <a href="/Config/Pools">Pools</a> page.</p>
    </div>
</div>

<h3>Monitoring</h3>
<ul class="form-errors" id="engine-errors"></ul>
@if (Model.EngineEnabled)
{
    <p>Monitoring is <b>on</b> — this node pings, records, and notifies.</p>
    <p><button type="button" id="engine-toggle-btn" class="secondary outline" data-enable="false">
        Disable monitoring (archive mode)</button>
        <small> The dashboard, History, report, and exports keep working read-only;
        pinging and notifications stop, and MQTT reads offline in Home Assistant.</small></p>
}
else
{
    <p>Monitoring is <b>off — archive mode</b>. History, the report, and exports
       stay available; nothing is pinged or notified.</p>
    <p><button type="button" id="engine-toggle-btn" data-enable="true">Enable monitoring</button></p>
}

@if (Model.CloneSource is { Length: > 0 })
{
    <h3>Migration</h3>
    <article>
        <ul class="form-errors" id="takeover-errors"></ul>
        <p>This node was cloned from <b>@Model.CloneSource</b>.
        When it looks right (targets, history, charts), take over: the source is
        disabled, one final snapshot closes the data gap to seconds, and this
        node goes live. The source remains a browsable archive.</p>
        <div class="grid">
            <label>Source admin password <small>(leave empty if the source has none)</small>
                <input type="password" id="takeover-password" autocomplete="off" />
            </label>
            <div style="align-self: end">
                <button type="button" id="takeover-btn">Take over from source</button>
            </div>
        </div>
        <div id="takeover-insecure" hidden>
            <p>The source address is plain HTTP on another machine: taking over would
            send its admin password and receive its secrets unencrypted. Use the
            source's HTTPS address if it has one, or confirm.</p>
            <button id="takeover-insecure-anyway" type="button" class="secondary">I understand — send it over HTTP</button>
        </div>
        <p id="takeover-result"></p>
    </article>
}

<h3>Traceroute</h3>
<ul class="form-errors" id="traceroute-errors"></ul>
<form id="traceroute-form">
    <label>Look up the operator of each hop
        <select name="@SettingKeys.TracerouteAsnLookup">
            <option value="false" selected="@(Model.Setting(SettingKeys.TracerouteAsnLookup, "false") != "true")">off</option>
            <option value="true" selected="@(Model.Setting(SettingKeys.TracerouteAsnLookup) == "true")">on</option>
        </select>
    </label>
    <p><small>When on, the Traceroute page sends the address of every public hop to
    Team Cymru's IP-to-ASN service through your DNS resolver, and names the operator
    ("COMCAST-7922") in the table and in "Add as target". Private addresses are never sent.</small></p>
    <button type="submit">Save traceroute settings</button>
</form>

<h3>Notifications</h3>
<ul class="form-errors" id="notify-errors"></ul>
<form id="notify-form">
    <h5>MQTT / Home Assistant</h5>
    <div class="grid">
        <label>Enabled
            <select name="@SettingKeys.MqttEnabled">
                <option value="false" selected="@(Model.Setting(SettingKeys.MqttEnabled, "false") != "true")">off</option>
                <option value="true" selected="@(Model.Setting(SettingKeys.MqttEnabled) == "true")">on</option>
            </select>
        </label>
        <label>Broker host
            <input name="@SettingKeys.MqttHost" placeholder="homeassistant.local"
                   value="@Model.Setting(SettingKeys.MqttHost)" />
        </label>
        <label>Port
            <input name="@SettingKeys.MqttPort" type="number" min="1" max="65535"
                   value="@Model.Setting(SettingKeys.MqttPort, "1883")" />
        </label>
    </div>
    <div class="grid">
        <label>Username <small>(optional)</small>
            <input name="@SettingKeys.MqttUsername" autocomplete="off"
                   value="@Model.Setting(SettingKeys.MqttUsername)" />
        </label>
        <label>Password <small>(optional)</small>
            <input name="@SettingKeys.MqttPassword" type="password" autocomplete="new-password"
                   value="@Model.Setting(SettingKeys.MqttPassword)" />
        </label>
        <label>Base topic
            <input name="@SettingKeys.MqttBaseTopic" placeholder="conwatch"
                   value="@Model.Setting(SettingKeys.MqttBaseTopic)" />
        </label>
        <label>Discovery prefix
            <input name="@SettingKeys.MqttDiscoveryPrefix" placeholder="homeassistant"
                   value="@Model.Setting(SettingKeys.MqttDiscoveryPrefix)" />
        </label>
    </div>
    <p><button type="button" id="mqtt-test-btn" class="outline">Test connection</button>
        <span id="mqtt-test-result"></span></p>

    <h5>Webhooks</h5>
    <div class="grid">
        <label>Enabled
            <select name="@SettingKeys.WebhookEnabled">
                <option value="false" selected="@(Model.Setting(SettingKeys.WebhookEnabled, "false") != "true")">off</option>
                <option value="true" selected="@(Model.Setting(SettingKeys.WebhookEnabled) == "true")">on</option>
            </select>
        </label>
        <label>Verdict changes only
            <select name="@SettingKeys.WebhookVerdictOnly">
                <option value="false" selected="@(Model.Setting(SettingKeys.WebhookVerdictOnly, "false") != "true")">no — every transition</option>
                <option value="true" selected="@(Model.Setting(SettingKeys.WebhookVerdictOnly) == "true")">yes — verdict only</option>
            </select>
        </label>
    </div>
    <label>Webhook URLs <small>(one per line)</small>
        <textarea name="@SettingKeys.WebhookUrls" rows="3"
                  placeholder="https://example.com/hook">@Model.Setting(SettingKeys.WebhookUrls)</textarea>
    </label>

    <h5>Heartbeat (watch the watchman)</h5>
    <p><small>While set, ConnectionWatcher GETs this URL on the interval to say
    "still alive". Point it at a dead-man's-switch service (e.g. healthchecks.io)
    and you get alerted when the pings <em>stop</em> &mdash; a dead NAS, a crashed
    container, or a full internet outage. Leave empty to disable.</small></p>
    <div class="grid">
        <label>Ping URL
            <input name="@SettingKeys.HeartbeatUrl" placeholder="https://hc-ping.com/your-uuid"
                   value="@Model.Setting(SettingKeys.HeartbeatUrl)" />
        </label>
        <label>Interval (minutes)
            <input name="@SettingKeys.HeartbeatIntervalMinutes" type="number" min="1" max="1440"
                   value="@Model.Setting(SettingKeys.HeartbeatIntervalMinutes, "5")" />
        </label>
    </div>
    <button type="submit">Save notifications</button>
</form>

<h3>Admin password</h3>
<ul class="form-errors" id="password-errors"></ul>
<p><small>This prevents casual tinkering with your configuration.
It is not internet-grade security &mdash; the password is sent over plain HTTP
on your network, and anyone with access to the server's files can remove it.</small></p>
@if (!Model.PasswordSet)
{
    <form id="password-form" data-mode="set">
        <div class="grid">
            <label>New password <input type="password" name="password" autocomplete="new-password" /></label>
            <label>Confirm <input type="password" name="confirm" autocomplete="new-password" /></label>
        </div>
        <button type="submit">Set admin password</button>
    </form>
}
else
{
    <form id="password-form" data-mode="change">
        <div class="grid">
            <label>Current password <input type="password" name="current" autocomplete="current-password" /></label>
            <label>New password <input type="password" name="password" autocomplete="new-password" /></label>
            <label>Confirm <input type="password" name="confirm" autocomplete="new-password" /></label>
        </div>
        <button type="submit">Change password</button>
        <button type="button" id="password-remove-btn" class="secondary">Remove password</button>
    </form>
}

<h3>Danger zone</h3>
<article style="border-color: var(--cw-down)">
    <ul class="form-errors" id="danger-errors"></ul>
    <div class="grid">
        <div>
            <h5>Clear measurement history</h5>
            <p>Deletes all transitions and rollups. Configuration and settings are kept.</p>
            <input id="clear-confirm" placeholder="type CLEAR to enable" autocomplete="off" />
            <button id="clear-btn" class="secondary" disabled>Clear history</button>
        </div>
        <div>
            <h5>Factory reset</h5>
            <p>Deletes everything — configuration, settings, and history — and returns to setup.</p>
            <input id="reset-confirm" placeholder="type RESET to enable" autocomplete="off" />
            <button id="reset-btn" class="secondary" disabled>Factory reset</button>
        </div>
        <div>
            <h5>Prune old history</h5>
            <p>Deletes measurement data recorded before the date — configuration,
               settings, and each target's latest state are kept. Compacts the
               database file afterwards.</p>
            <input id="prune-date" type="date" autocomplete="off" />
            <input id="prune-confirm" placeholder="type PRUNE to enable" autocomplete="off" />
            <button id="prune-btn" class="secondary" disabled>Prune</button>
            <p id="prune-result"></p>
        </div>
    </div>
</article>

@section Scripts {
    <script src="~/lib/site-config.js" asp-append-version="true"></script>
    <script src="~/lib/site-settings.js" asp-append-version="true"></script>
}

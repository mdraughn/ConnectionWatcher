@inject ConWatch.Auth.AdminGate Gate
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "ConnectionWatcher")</title>
    <link rel="stylesheet" href="~/css/pico.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="container">
        <ul><li class="cw-brand">
            <strong>ConnectionWatcher</strong>
            <small id="cw-build" class="cw-build"
                   data-version="@ConWatch.BuildInfo.Version"
                   data-built-utc="@(ConWatch.BuildInfo.BuiltUtc?.ToString("o") ?? "")"
                   title="build @ConWatch.BuildInfo.Version — @(ConWatch.BuildInfo.BuiltUtc?.ToString("u") ?? "build time unknown")">
                v@(ConWatch.BuildInfo.Version)</small>
        </li></ul>
        <ul>
            <li><a href="/">Dashboard</a></li>
            <li><a href="/History">History</a></li>
            @if (!Gate.IsLocked(User))
            {
                <li><a href="/Config/Targets">Config</a></li>
                <li><a href="/Traceroute">Traceroute</a></li>
                <li><a href="/Admin">Admin</a></li>
                @if (Gate.IsEnabled)
                {
                    <li><a href="#" id="nav-exit-admin"
                           onclick="fetch('/api/v1/auth/logout',{method:'POST'}).then(()=>location.href='/');return false;">
                           exit admin mode</a></li>
                }
            }
        </ul>
    </nav>
    <main class="container">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // Localize the header build stamp; without JS it stays version-only.
        (function () {
            var el = document.getElementById("cw-build");
            if (!el || !el.dataset.builtUtc) return;
            var d = new Date(el.dataset.builtUtc);
            if (isNaN(d)) return;
            el.textContent = "v" + el.dataset.version + " · built " + d.toLocaleString(undefined,
                { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" });
        })();
    </script>
</body>
</html>

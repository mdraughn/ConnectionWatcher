@page
@using ConEngine.Tracking
@model ConWatch.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard — ConnectionWatcher";
}

@functions {
    private void RenderNode(TargetMonitor monitor)
    {
        <li>
            <div class="cw-row">
                <span class="dot @monitor.CurrentState.ToString().ToLowerInvariant()"></span>
                <span>@monitor.Target.Name</span>
                <span class="stats">@monitor.CurrentState</span>
            </div>
            @if (Model.Children.TryGetValue(monitor.Target.Id, out var children))
            {
                <ul>
                    @foreach (var child in children)
                    {
                        RenderNode(child);
                    }
                </ul>
            }
        </li>
    }
}

@if (Model.WarningCount > 0)
{
    <p class="cw-health-hint">
        ⚠ @Model.WarningCount configuration warning@(Model.WarningCount == 1 ? "" : "s") —
        <a href="/Config/Targets">review on the Targets page</a>
    </p>
}
<script id="initial-data" type="application/json">@Html.Raw(Model.InitialDataJson)</script>

<div id="dashboard-root">
    @* Server-rendered fallback: correct at page load; the island replaces it. *@
    <ul class="cw-tree">
        @foreach (var root in Model.Roots)
        {
            RenderNode(root);
        }
    </ul>
    @if (Model.EngineDisabled)
    {
        <p>⏸ Monitoring is disabled (archive mode) — history and reports stay
           available; re-enable on the <a href="/Admin">Admin</a> page.</p>
    }
    else if (Model.Roots.Count == 0)
    {
        <p>No targets configured yet — add some on the <a href="/Config/Targets">Targets</a> page.</p>
    }
</div>

@if (Model.ShowLock)
{
    <p style="text-align:right">
        <button id="admin-lock-btn" class="outline secondary"
                onclick="document.getElementById('admin-dialog').showModal()">🔒 Admin</button>
    </p>
    <dialog id="admin-dialog">
        <article>
            <h4>Enter admin password</h4>
            <ul class="form-errors" id="admin-dialog-errors"></ul>
            <form id="admin-login-form">
                <input type="password" id="admin-password" autocomplete="current-password" autofocus />
                <button type="submit">Enable admin mode</button>
                <button type="button" class="secondary outline"
                        onclick="document.getElementById('admin-dialog').close()">Cancel</button>
            </form>
            <details>
                <summary>Forgot the password?</summary>
                <p>On the machine running ConnectionWatcher, delete this file and reload the page:
                   <code>@Model.ResetPath</code></p>
            </details>
        </article>
    </dialog>
    <script>
        document.getElementById("admin-login-form").addEventListener("submit", async (e) => {
            e.preventDefault();
            const r = await fetch("/api/v1/auth/login", {
                method: "POST", headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ password: document.getElementById("admin-password").value }),
            });
            if (r.ok) location.href = "/";
            else document.getElementById("admin-dialog-errors").innerHTML = "<li>Wrong password.</li>";
        });
        if (new URLSearchParams(location.search).get("admin") === "1") {
            document.getElementById("admin-dialog").showModal();
            // Drop the flag from the URL right away, so a refresh (or a
            // cancel followed by a refresh) doesn't re-prompt.
            history.replaceState(null, "", location.pathname);
        }
    </script>
}

@section Scripts {
    <script type="module" src="~/js/dashboard.js" asp-append-version="true"></script>
}

@page
@model ConWatch.Pages.ReportModel
@{
    ViewData["Title"] = "Connection report — ConnectionWatcher";
    var r = Model.Report;
}

<style media="print">
    nav, .no-print { display: none !important; }
    main { padding-bottom: 0 !important; }
</style>

<div class="no-print" style="float:right">
    <button onclick="window.print()">Print / save as PDF</button>
</div>

<h2>Internet connection report</h2>
<p>
    <b>Period:</b> @r.FromUtc.ToString("yyyy-MM-dd HH:mm") — @r.ToUtc.ToString("yyyy-MM-dd HH:mm") UTC<br />
    <b>Monitored path:</b> @(r.PathNames.Count > 0 ? string.Join(" → ", r.PathNames) : "—")
    → internet anchors (@string.Join(", ", r.AnchorNames))<br />
    <b>Method:</b> continuous ICMP monitoring of the local path and @r.AnchorNames.Count public
    anycast services, with outage attribution recorded at the moment of each incident.
</p>

<h3>Summary</h3>
<ul>
    <li><b>Line down (attributable to the connection):</b> @ReportModel.Duration(r.LinkDownTime)</li>
    <li><b>Line degraded:</b> @ReportModel.Duration(r.LinkDegradedTime)</li>
    <li><b>Widespread internet disturbances ("weather"):</b> @ReportModel.Duration(r.WeatherTime)</li>
    <li><b>Measured anchor uptime:</b> @(r.AnchorUptimePercent is { } up ? $"{up:F3}%" : "no data")</li>
</ul>
<p>
    Single-site incidents (one destination misbehaving while the rest of the
    internet was reachable) are <i>excluded</i> from the figures above — they are
    not attributable to the connection.
</p>

<h3>Incidents</h3>
@if (r.Episodes.Count == 0)
{
    <p>No attributable incidents were recorded in this period.</p>
}
else
{
    <table>
        <thead><tr><th>Start (UTC)</th><th>End (UTC)</th><th>Duration</th><th>Kind</th><th>Recorded evidence</th></tr></thead>
        <tbody>
        @foreach (var e in r.Episodes)
        {
            <tr>
                <td>@e.StartUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@e.EndUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@ReportModel.Duration(e.Duration)</td>
                <td>@(e.Kind == "InternetWeather" ? "Widespread" : e.Kind == "LinkDown" ? "Line down" : "Line degraded")</td>
                <td>@e.Evidence</td>
            </tr>
        }
        </tbody>
    </table>
}

<h3>Per-target detail</h3>
<table>
    <thead><tr><th>Target</th><th>Address</th><th>Role</th><th>Uptime</th><th>Outages</th><th>Longest outage</th><th>No-data time</th></tr></thead>
    <tbody>
    @foreach (var t in r.Targets)
    {
        <tr>
            <td>@t.Name</td>
            <td>@t.Address</td>
            <td>@(t.IsAnchor ? "anchor" : "path")</td>
            <td>@(t.UptimePercent is { } targetUp ? $"{targetUp:F2}%" : "—")</td>
            <td>@t.OutageCount</td>
            <td>@ReportModel.Duration(t.LongestOutage)</td>
            <td>@ReportModel.Duration(t.UnreachableTime)</td>
        </tr>
    }
    </tbody>
</table>

<p><small>Generated by ConnectionWatcher. Timestamps are UTC.</small></p>

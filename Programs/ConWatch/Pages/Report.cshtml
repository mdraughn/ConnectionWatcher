@page
@model ConWatch.Pages.ReportModel
@{
    ViewData["Title"] = "Connection report — ConnectionWatcher";
    var r = Model.Report;
    // Dual-time cell: a <time> the script localizes, over the fixed UTC value.
    // Without JS only the UTC text shows — never a wrong or unlabeled time.
    Func<DateTime, string, object> Dual = (utc, format) =>
        Html.Raw($"<time class=\"cw-lt\" datetime=\"{new DateTimeOffset(DateTime.SpecifyKind(utc, DateTimeKind.Utc)):O}\"></time>" +
                 $"<span class=\"cw-utc\">{utc.ToString(format)} UTC</span>");
}

<style media="print">
    nav, .no-print { display: none !important; }
    main { padding-bottom: 0 !important; }
</style>

<div class="no-print" style="float:right">
    <button onclick="window.print()">Print / save as PDF</button>
</div>

<h2>Internet connection report@(r.OperatorName is { Length: > 0 } ? $" — {r.OperatorName} service" : "")</h2>
<p id="tz-note"><small>Times are shown in <b><span id="tz-name">UTC</span></b><span id="tz-detail"></span>.</small></p>
<p>
    <b>Period:</b> @Dual(r.FromUtc, "yyyy-MM-dd HH:mm") — @Dual(r.ToUtc, "yyyy-MM-dd HH:mm")<br />
    <b>Monitored path:</b> @(r.PathNames.Count > 0 ? string.Join(" → ", r.PathNames) : "—")
    → internet anchors (@string.Join(", ", r.AnchorNames))<br />
    <b>Method:</b> continuous reachability monitoring (ICMP ping / TCP connect) of the local path and @r.AnchorNames.Count public
    anycast services, with outage attribution recorded at the moment of each incident.
</p>

<h3>Summary</h3>
<ul>
    <li><b>Line down (attributable to the connection):</b> @ReportModel.Duration(r.LinkDownTime)</li>
    <li><b>Line degraded:</b> @ReportModel.Duration(r.LinkDegradedTime)</li>
    <li><b>Widespread internet disturbances ("weather"):</b> @ReportModel.Duration(r.WeatherTime)</li>
    <li><b>Measured anchor uptime:</b> @(r.AnchorUptimePercent is { } up ? $"{up:F3}%" : "no data")</li>
</ul>
<p>
    Single-site incidents (one destination misbehaving while the rest of the
    internet was reachable) are <i>excluded</i> from the figures above — they are
    not attributable to the connection.
</p>

<h3>Incidents</h3>
@if (r.Episodes.Count == 0)
{
    <p>No attributable incidents were recorded in this period.</p>
}
else
{
    <table>
        <thead><tr><th>Start</th><th>End</th><th>Duration</th><th>Kind</th><th>Recorded evidence</th></tr></thead>
        <tbody>
        @foreach (var e in r.Episodes)
        {
            <tr>
                <td>@Dual(e.StartUtc, "yyyy-MM-dd HH:mm:ss")</td>
                <td>@Dual(e.EndUtc, "yyyy-MM-dd HH:mm:ss")</td>
                <td>@ReportModel.Duration(e.Duration)</td>
                <td>@(e.Kind == "InternetWeather" ? "Widespread" : e.Kind == "LinkDown" ? "Line down" : "Line degraded")</td>
                <td>@e.Evidence</td>
            </tr>
        }
        </tbody>
    </table>
}

<h3>Brief disturbances (glitches)</h3>
@if (r.Glitches.TotalCount == 0)
{
    <p>No sub-outage loss episodes were recorded in this period.</p>
}
else
{
    <p>
        <b>@r.Glitches.TotalCount</b> brief loss episode@(r.Glitches.TotalCount == 1 ? "" : "s")
        too short to register as outages
        (@r.Glitches.InternetCount of them corroborated across multiple destinations).
        @if (r.Glitches.TopHours.Count > 0)
        {
            var top = r.Glitches.TopHours[0];
            var clustered = r.Glitches.TopHours.Sum(h => h.Count);
            <text>Most frequent hours (UTC): @string.Join(", ", r.Glitches.TopHours.Select(h => $"{h.HourUtc:00}:00 ({h.Count})"))
            — @clustered of @r.Glitches.TotalCount fall in these @r.Glitches.TopHours.Count hour@(r.Glitches.TopHours.Count == 1 ? "" : "s").</text>
        }
    </p>
    @if (r.Glitches.ChronicTargets.Count > 0)
    {
        <p>Chronically glitchy in the final 24 h of the period:
           <b>@string.Join(", ", r.Glitches.ChronicTargets)</b>.</p>
    }
}

<h3>Per-target detail</h3>
<table>
    <thead><tr><th>Target</th><th>Address</th><th>Role</th><th>Uptime</th><th>Outages</th><th>Longest outage</th><th>No-data time</th></tr></thead>
    <tbody>
    @foreach (var t in r.Targets)
    {
        <tr>
            <td>@t.Name</td>
            <td>@t.Address</td>
            <td>@(t.IsAnchor ? "anchor" : "path")</td>
            <td>@(t.UptimePercent is { } targetUp ? $"{targetUp:F2}%" : "—")</td>
            <td>@t.OutageCount</td>
            <td>@ReportModel.Duration(t.LongestOutage)</td>
            <td>@ReportModel.Duration(t.UnreachableTime)</td>
        </tr>
    }
    </tbody>
</table>

<p><small>Generated by ConnectionWatcher. Every timestamp also carries its UTC
value so incidents can be correlated with a provider's own (usually UTC) logs.</small></p>

<style>
    .cw-lt { font-weight: 600; }
    .cw-lt:empty + .cw-utc { font-size: inherit; opacity: 1; } /* no JS: UTC is the only time */
    .cw-lt:not(:empty) + .cw-utc { display: block; font-size: 0.75em; opacity: 0.6; }
</style>
<script>
    // Localize every dual-time cell; the UTC line stays for correlation.
    (function () {
        var zone;
        try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone; } catch { return; }
        var times = document.querySelectorAll("time.cw-lt");
        if (!zone || times.length === 0) return;
        times.forEach(function (el) {
            var d = new Date(el.getAttribute("datetime"));
            if (isNaN(d)) return;
            el.textContent = d.toLocaleString(undefined, {
                year: "numeric", month: "2-digit", day: "2-digit",
                hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false,
            });
        });
        document.getElementById("tz-name").textContent = zone;
        document.getElementById("tz-detail").textContent =
            " (this browser's time zone); the small line under each time is UTC";
    })();
</script>

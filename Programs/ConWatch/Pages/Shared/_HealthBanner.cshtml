@model IReadOnlyList<ConPersistence.HealthWarning>
@if (Model.Count > 0)
{
    <div class="cw-health" role="alert">
        <b>Configuration warnings</b>
        <ul>
            @foreach (var warning in Model)
            {
                <li data-code="@warning.Code">@warning.Message</li>
            }
        </ul>
    </div>
}

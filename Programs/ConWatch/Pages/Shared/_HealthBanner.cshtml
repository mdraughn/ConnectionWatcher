@model IReadOnlyList<ConPersistence.Config.HealthWarning>
@if (Model.Count > 0)
{
    var here = Context.Request.Path.Value ?? "";
    <div class="cw-health" role="alert">
        <b>Configuration warnings</b>
        <ul>
            @foreach (var warning in Model)
            {
                <li data-code="@warning.Code">@warning.Message
                    @if (!string.Equals(warning.Page, here, StringComparison.OrdinalIgnoreCase))
                    {
                        <a href="@warning.Page">→ @warning.PageName @(warning.Page.StartsWith("/Config/") ? "tab" : "page")</a>
                    }
                </li>
            }
        </ul>
    </div>
}

<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\Core\ConEngine\ConEngine.csproj" />
    <ProjectReference Include="..\..\Libraries\ConInfrastructure\ConInfrastructure.csproj" />
    <ProjectReference Include="..\..\Libraries\ConPersistence\ConPersistence.csproj" />
    <ProjectReference Include="..\..\Libraries\ConNotify\ConNotify.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Version, Company and Product come from Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="ClientApp\**" Exclude="ClientApp\node_modules\**;ClientApp\dist\**" />
    <Content Remove="ClientApp\**" />
  </ItemGroup>

  <!-- SkipClientBuild=true lets Docker build the bundles in a Node stage. -->
  <Target Name="EnsureClientBuild" BeforeTargets="Build" Condition="!Exists('wwwroot\js\dashboard.js') AND '$(SkipClientBuild)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="ClientApp" Condition="!Exists('ClientApp\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="ClientApp" />
  </Target>

  <Target Name="PublishClientBuild" BeforeTargets="ComputeFilesToPublish" Condition="'$(SkipClientBuild)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="ClientApp" />
    <Exec Command="npm run build" WorkingDirectory="ClientApp" />
  </Target>

</Project>

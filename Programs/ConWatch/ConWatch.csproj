<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <InternalsVisibleTo Include="ConWatch.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\ConEngine\ConEngine.csproj" />
    <ProjectReference Include="..\..\Libraries\ConInfrastructure\ConInfrastructure.csproj" />
    <ProjectReference Include="..\..\Libraries\ConPersistence\ConPersistence.csproj" />
    <ProjectReference Include="..\..\Libraries\ConNotify\ConNotify.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Version, Company and Product come from Directory.Build.props. -->
    <!-- AssemblyName is explicitly "ConWatchHost", not the default "ConWatch": the new
         ConWatchCli project (Programs/ConWatchCli) must be named exactly "conwatch", and on a
         case-insensitive filesystem "conwatch.dll"/"conwatch.exe" and "ConWatch.dll"/
         "ConWatch.exe" address the SAME path once both land in ConWatchCli's own output
         directory (a P2P dependency's build output is always copied beside the referencing
         exe) - whichever is written last silently wins, and the loader then fails to find
         ConWatch.ConWatchApp inside what is actually the conwatch.exe bytes. This is a build/
         runtime necessity, not a namespace change: the C# namespace stays "ConWatch"
         everywhere. Deployment paths that hardcode the old filename (Dockerfile) were
         updated to match. -->
    <AssemblyName>ConWatchHost</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Include="ClientApp\**" Exclude="ClientApp\node_modules\**;ClientApp\dist\**" />
    <Content Remove="ClientApp\**" />
  </ItemGroup>

  <!-- The bundle is rebuilt whenever a client source is newer than it (MSBuild's
       Inputs/Outputs check), not only when it is missing: a stale bundle from an
       earlier checkout state must never ship. The installer publishes ConWatchCli,
       so this project is only built, never published — a publish-time target would
       not run for it. The build runs BEFORE BeforeBuild, because the static web
       asset list is taken from @(Content) early in the build: Vite names the shared
       chunk by content hash and deletes the old one, so the list must be refreshed
       after the build or the referencing project fails with MSB4018 on a file that
       no longer exists. SkipClientBuild=true lets Docker build in a Node stage. -->
  <ItemGroup>
    <ClientSource Include="ClientApp\src\**;ClientApp\package.json;ClientApp\package-lock.json;ClientApp\vite.config.ts;ClientApp\tsconfig.json" />
  </ItemGroup>
  <Target Name="EnsureClientDeps" Inputs="ClientApp\package-lock.json" Outputs="ClientApp\node_modules\.package-lock.json" Condition="'$(SkipClientBuild)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="ClientApp" />
  </Target>
  <Target Name="EnsureClientBuild" BeforeTargets="BeforeBuild" DependsOnTargets="EnsureClientDeps" Inputs="@(ClientSource)" Outputs="wwwroot\js\dashboard.js;wwwroot\js\history.js" Condition="'$(SkipClientBuild)' != 'true'">
    <Exec Command="npm run build" WorkingDirectory="ClientApp" />
    <ItemGroup>
      <_StaleBundle Include="@(Content)" Condition="'%(RelativeDir)' == 'wwwroot\js\'" />
      <Content Remove="@(_StaleBundle)" />
      <Content Include="wwwroot\js\**" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

</Project>

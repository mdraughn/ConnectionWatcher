@page
@model ConDiag.Pages.IndexModel
@{
    ViewData["Title"] = "ConDiag - Connection Diagnostics";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="display-4 text-primary">
                <i class="fas fa-network-wired"></i>
                ConDiag - Connection Diagnostics
            </h1>
            <p class="lead">Real-time network connectivity monitoring and diagnostics</p>
        </div>
    </div>

    <div class="row">
        <!-- Live Status Card -->
        <div class="col-lg-6 col-md-12 mb-4">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-heartbeat"></i>
                        Live Status
                    </h5>
                </div>
                <div class="card-body">
                    <div id="status-display">
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Loading status...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Ping Test Card -->
        <div class="col-lg-6 col-md-12 mb-4">
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-satellite-dish"></i>
                        Quick Ping Test
                    </h5>
                </div>
                <div class="card-body">
                    <form id="ping-form">
                        <div class="mb-3">
                            <label for="ping-host" class="form-label">Host:</label>
                            <input type="text" class="form-control" id="ping-host" value="8.8.8.8" placeholder="Enter host to ping">
                        </div>
                        <div class="mb-3">
                            <label for="ping-count" class="form-label">Number of pings:</label>
                            <select class="form-select" id="ping-count">
                                <option value="1">1</option>
                                <option value="4" selected>4</option>
                                <option value="10">10</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-success w-100">
                            <i class="fas fa-play"></i>
                            Run Ping Test
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Ping Results -->
    <div class="row">
        <div class="col-12">
            <div class="card border-info">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-chart-line"></i>
                        Ping Test Results
                    </h5>
                </div>
                <div class="card-body">
                    <div id="ping-results">
                        <p class="text-muted text-center">Run a ping test to see results here</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Background Worker Activity -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-warning">
                <div class="card-header bg-warning text-dark">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-cogs"></i>
                        Background Worker Activity
                    </h5>
                </div>
                <div class="card-body">
                    <div id="worker-activity">
                        <p class="text-muted">Background ping monitoring is active for 8.8.8.8 every 5 seconds</p>
                        <small class="text-muted">Check the console output or API endpoints for detailed logs</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-refresh status every 10 seconds
        setInterval(loadStatus, 10000);
        
        // Load initial status
        loadStatus();

        // Handle ping form submission
        document.getElementById('ping-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            await runPingTest();
        });

        async function loadStatus() {
            try {
                const response = await fetch('/api/diagnostics/status');
                const data = await response.json();
                
                document.getElementById('status-display').innerHTML = `
                    <div class="row text-center">
                        <div class="col-md-6">
                            <div class="border-end">
                                <h3 class="text-success">?</h3>
                                <p class="mb-0"><strong>Service Status</strong></p>
                                <p class="text-success">${data.status}</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h3 class="text-primary">?</h3>
                            <p class="mb-0"><strong>Workers Active</strong></p>
                            <p class="text-primary">${data.backgroundWorkers.length}</p>
                        </div>
                    </div>
                    <div class="mt-3">
                        <small class="text-muted">Last updated: ${new Date(data.timestamp).toLocaleString()}</small>
                    </div>
                `;
            } catch (error) {
                document.getElementById('status-display').innerHTML = `
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle"></i>
                        Failed to load status: ${error.message}
                    </div>
                `;
            }
        }

        async function runPingTest() {
            const host = document.getElementById('ping-host').value;
            const count = document.getElementById('ping-count').value;
            const resultsDiv = document.getElementById('ping-results');
            
            // Show loading
            resultsDiv.innerHTML = `
                <div class="text-center">
                    <div class="spinner-border text-info" role="status">
                        <span class="visually-hidden">Testing...</span>
                    </div>
                    <p class="mt-2">Running ping test to ${host}...</p>
                </div>
            `;

            try {
                const response = await fetch(`/api/diagnostics/ping-test?host=${encodeURIComponent(host)}&count=${count}`);
                const data = await response.json();
                
                let resultsHtml = `
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <strong>Host:</strong> ${data.host}
                        </div>
                        <div class="col-md-3">
                            <strong>Success Rate:</strong> 
                            <span class="badge ${data.successRate >= 80 ? 'bg-success' : data.successRate >= 50 ? 'bg-warning' : 'bg-danger'}">
                                ${data.successRate}%
                            </span>
                        </div>
                        <div class="col-md-3">
                            <strong>Avg Response:</strong> ${data.averageResponseTime ? data.averageResponseTime + 'ms' : 'N/A'}
                        </div>
                        <div class="col-md-3">
                            <strong>Total Pings:</strong> ${data.totalPings}
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Status</th>
                                    <th>Response Time</th>
                                    <th>Timestamp</th>
                                </tr>
                            </thead>
                            <tbody>
                `;

                data.results.forEach(result => {
                    const statusClass = result.success ? 'text-success' : 'text-danger';
                    const statusIcon = result.success ? '?' : '?';
                    resultsHtml += `
                        <tr>
                            <td>${result.sequence}</td>
                            <td class="${statusClass}">
                                ${statusIcon} ${result.status}
                            </td>
                            <td>${result.roundtripTime ? result.roundtripTime + 'ms' : 'N/A'}</td>
                            <td>${new Date(result.timestamp).toLocaleTimeString()}</td>
                        </tr>
                    `;
                });

                resultsHtml += `
                            </tbody>
                        </table>
                    </div>
                `;

                resultsDiv.innerHTML = resultsHtml;
            } catch (error) {
                resultsDiv.innerHTML = `
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle"></i>
                        Ping test failed: ${error.message}
                    </div>
                `;
            }
        }
    </script>
}
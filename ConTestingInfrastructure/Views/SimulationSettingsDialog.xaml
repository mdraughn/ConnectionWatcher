<Window x:Class="ConInfrastructure.Views.SimulationSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Simulation Settings" Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Latency Settings -->
                <GroupBox Header="Latency Settings" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Mean Round-Trip Time (ms):" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="MeanRttTextBox" Width="100" Text="{Binding MeanRoundTripTimeMs}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Std Dev (ms):" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="RttStdDevTextBox" Width="100" Text="{Binding RoundTripTimeStdDevMs}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Min Round-Trip Time (ms):" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="MinRttTextBox" Width="100" Text="{Binding MinRoundTripTimeMs}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Max Round-Trip Time (ms):" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="MaxRttTextBox" Width="100" Text="{Binding MaxRoundTripTimeMs}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Packet Loss Settings -->
                <GroupBox Header="Packet Loss Settings" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Base Packet Loss Rate (0-1):" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="BasePacketLossTextBox" Width="100" Text="{Binding BasePacketLossRate}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Outage Settings -->
                <GroupBox Header="Outage Settings" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Outage Probability (0-1):" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="OutageProbabilityTextBox" Width="100" Text="{Binding OutageProbability}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Mean Outage Duration (ms):" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="MeanOutageDurationTextBox" Width="100" Text="{Binding MeanOutageDurationMs}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Outage Duration Std Dev (ms):" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="OutageDurationStdDevTextBox" Width="100" Text="{Binding OutageDurationStdDevMs}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Min Outage Duration (ms):" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="MinOutageDurationTextBox" Width="100" Text="{Binding MinOutageDurationMs}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Max Outage Duration (ms):" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="MaxOutageDurationTextBox" Width="100" Text="{Binding MaxOutageDurationMs}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Outage Packet Loss Rate (0-1):" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="OutagePacketLossTextBox" Width="100" Text="{Binding OutagePacketLossRate}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Random Seed -->
                <GroupBox Header="Random Seed (Optional)" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Random Seed:" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="RandomSeedTextBox" Width="100" Text="{Binding RandomSeed}"/>
                            <TextBlock Text="(blank for random)" Margin="10,0,0,0" VerticalAlignment="Center" FontStyle="Italic"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" Height="30" Margin="5,0" IsDefault="True" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="5,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

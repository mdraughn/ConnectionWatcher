<UserControl x:Class="ConInfrastructure.Views.PingSimulatorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="750">
    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Margin="5" Padding="10" Background="#FFF5F5F5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- IP Address -->
            <TextBlock Grid.Column="0" Grid.Row="0" 
                       Text="{Binding IpAddress}" 
                       FontWeight="Bold" 
                       FontSize="14"
                       VerticalAlignment="Center"/>

            <!-- Outage Toggle Button -->
            <ToggleButton Grid.Column="1" Grid.Row="0"
                          x:Name="OutageButton"
                          IsChecked="{Binding IsOutageActive}"
                          Height="30"
                          Margin="5,0">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Content" Value="Start Outage"/>
                        <Setter Property="Background" Value="#FFFF6B6B"/>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content" Value="Stop Outage"/>
                                <Setter Property="Background" Value="#FF4ECDC4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <!-- Settings Button -->
            <Button Grid.Column="2" Grid.Row="0"
                    x:Name="SettingsButton"
                    Content="Settings"
                    Height="30"
                    Margin="5,0"
                    Click="SettingsButton_Click"/>

            <!-- Total Pings -->
            <StackPanel Grid.Column="3" Grid.Row="0" Orientation="Horizontal" Margin="5,0">
                <TextBlock Text="Pings: " FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TotalPings}"/>
            </StackPanel>

            <!-- Last Result -->
            <StackPanel Grid.Column="4" Grid.Row="0" Orientation="Horizontal" Margin="5,0">
                <TextBlock Text="Last: " FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LastResult}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
